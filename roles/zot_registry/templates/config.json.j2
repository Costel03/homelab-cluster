{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/zot",
    "gc": true,
    "gcDelay": "1h",
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "{{ registry_port }}",
    "compat": ["docker2s2"],
    "auth": {
      "htpasswd": { "path": "/etc/zot/htpasswd" },
      "failDelay": 1
    },
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read"],
          "policies": [
            { "users": ["{{ zot_ci_user }}"], "actions": ["read", "create", "update", "delete"] }
          ]
        }
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true,
      "cve": { "updateInterval": "24h" }
    },
    "ui": { "enable": true },
    "sync": {
      "enable": true,
      "registries": [
{% for reg in mirrored_registries %}
        {
          "urls": ["{{ reg.upstream }}"],
          "content": [{ "prefix": "**", "destination": "/{{ reg.name }}" }],
          "onDemand": true,
          "preserveDigest": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "5s"
        }{{ "," if not loop.last }}
{% endfor %}
      ]
    }
  }
}
