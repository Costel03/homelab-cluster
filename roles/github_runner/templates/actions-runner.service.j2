[Unit]
Description=GitHub Actions runner for {{ github_runner_repo }}
After=network-online.target zot.service
Wants=network-online.target

[Service]
User={{ github_runner_user }}
WorkingDirectory={{ github_runner_dir }}
ExecStart={{ github_runner_dir }}/runsvc.sh
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
