#cloud-config
hostname: {{ vm_name }}
fqdn: {{ vm_name }}
manage_etc_hosts: true

users:
- name: {{ node_user }}
  groups: [adm, sudo]
  shell: /bin/bash
  lock_passwd: true
  sudo: "ALL=(ALL) NOPASSWD:ALL"
  ssh_authorized_keys:
  - {{ ssh_public_key }}

# No packages and no package_update on purpose: the cloud image already ships
# python3, which is all Ansible needs, and an apt update on first boot adds
# minutes per node for nothing. k8s_common installs everything else.

write_files:
# Matched by MAC, not interface name: VirtualBox NIC naming varies by chipset,
# the MAC is pinned when the VM is created.
- path: /etc/netplan/99-homelab.yaml
  permissions: '0600'
  content: |
    network:
      version: 2
      renderer: networkd
      ethernets:
        hostonly:
          match:
            macaddress: "{{ vm_mac_colons }}"
          set-name: hostonly
          addresses: [{{ vm_ip }}/{{ net_prefix }}]

runcmd:
- [netplan, apply]
- [swapoff, -a]
