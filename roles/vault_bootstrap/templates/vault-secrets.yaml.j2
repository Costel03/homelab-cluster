apiVersion: v1
kind: Namespace
metadata:
  name: eso
---
apiVersion: v1
kind: Secret
metadata:
  name: vault-token
  namespace: eso
type: Opaque
stringData:
  token: {{ vault_root_token | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: vault-unseal-key
  namespace: hashicorp-vault
type: Opaque
stringData:
  key: {{ vault_unseal_key | to_json }}
