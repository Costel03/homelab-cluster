apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: app-of-apps
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ gitops_repo_url }}
    targetRevision: {{ gitops_repo_revision }}
    path: apps
    helm:
      parameters:
      - name: repo.url
        value: {{ gitops_repo_url }}
      - name: repo.revision
        value: {{ gitops_repo_revision }}
      - name: registry.host
        value: "{{ registry_host }}"
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    retry:
      limit: -1
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
